# NearGrow Ads — Environment Configuration Template
# Verified details extracted from neargrowads.in

PORT=3000
NODE_ENV=development

# Site URL for canonical URLs and sitemaps
SITE_URL="https://your-production-domain.example"
TRUST_PROXY_HOPS=0
PERSISTENT_DATA_DIR=""

# Verified Phone & WhatsApp Destination
WHATSAPP_NUMBER=""
PHONE_NUMBER=""

# Verified Notification Recipient Email for Team Inquiries
CONTACT_NOTIFICATION_EMAIL=""
ADMIN_NOTIFICATION_EMAIL=""

# CMS authentication (Supabase Auth uses individual verified accounts)
ADMIN_OWNER_USER_ID=""
ADMIN_SESSION_SECRET=""

# Verified Google Analytics 4 Measurement ID from neargrowads.in
GA_MEASUREMENT_ID=""

# Supabase Auth + database (service role key stays on the server)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay Test-only checkout. Use deployment secret storage; never commit these values.
# Live credentials and live payment mode are intentionally unsupported by this checkout.
RAZORPAY_TEST_KEY_ID=""
RAZORPAY_TEST_KEY_SECRET=""
RAZORPAY_TEST_WEBHOOK_SECRET=""

# Optional: n8n Lead Workflow Automation
N8N_LEAD_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
