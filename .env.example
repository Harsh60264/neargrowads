# NearGrow Ads — Environment Configuration Template
# NearGrow Ads environment configuration

PORT=3000
NODE_ENV=development

# Local development default; set Production to exactly https://www.neargrowads.com.
# Use the Preview deployment's HTTPS origin for Preview deployments.
SITE_URL="http://localhost:3000"
# Optional Vite build-time canonical origin; set to the same origin when configured.
VITE_SITE_URL=""
TRUST_PROXY_HOPS=0
PERSISTENT_DATA_DIR=""

# Phone and WhatsApp destinations
WHATSAPP_NUMBER=""
PHONE_NUMBER=""

# Notification recipients for team inquiries
CONTACT_NOTIFICATION_EMAIL=""
ADMIN_NOTIFICATION_EMAIL=""

# CMS authentication (Supabase Auth uses individual verified accounts)
ADMIN_OWNER_USER_ID=""
ADMIN_OWNER_EMAIL=""
# Set these only in Vercel Preview; all staging identity and project bindings must match.
ADMIN_STAGING_SUPABASE_PROJECT_REF=""
ADMIN_STAGING_OWNER_USER_ID=""
ADMIN_STAGING_OWNER_EMAIL=""
# Optional non-secret Preview guard values; when supplied, they must differ from the staging Owner.
ADMIN_PRODUCTION_OWNER_USER_ID=""
ADMIN_PRODUCTION_OWNER_EMAIL=""
# Duplicate the staging-issued keys here only as explicit Preview configuration pins.
ADMIN_STAGING_SUPABASE_ANON_KEY=""
ADMIN_STAGING_SUPABASE_SERVICE_ROLE_KEY=""
ADMIN_STAGING_SESSION_SECRET=""
ADMIN_SESSION_SECRET=""

# New-admin temporary-password onboarding (server-side Resend API; never expose as VITE_ variables)
RESEND_API_KEY=""
ADMIN_INVITATION_EMAIL_FROM="NearGrow Ads <no-reply@neargrowads.com>"

# Google Analytics 4 Measurement ID
GA_MEASUREMENT_ID=""

# Supabase Auth + database (service role key stays on the server)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay Test-only checkout. Use deployment secret storage; never commit these values.
# Live credentials and live payment mode are intentionally unsupported by this checkout.
RAZORPAY_TEST_KEY_ID=""
RAZORPAY_TEST_KEY_SECRET=""
RAZORPAY_TEST_WEBHOOK_SECRET=""

# Optional: n8n Lead Workflow Automation
N8N_LEAD_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
