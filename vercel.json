{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/admin/accept-invite",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/admin/password-reset",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/google-ads-delhi",
      "destination": "/services/google-ads",
      "statusCode": 301
    },
    {
      "source": "/gmb-audit/",
      "destination": "/services/google-business-profile",
      "statusCode": 301
    }
  ],
  "functions": {
    "api/handler.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/handler?__vercel_original_api_path=/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?__vercel_original_api_path=/api/:path*"
    },
    {
      "source": "/uploads/:folder/:filename",
      "destination": "/api/handler?__vercel_original_api_path=/api/uploads/:folder/:filename"
    },
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/catalogue",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/services/:path*",
      "destination": "/api/handler?__vercel_original_api_path=/services/:path*"
    },
    {
      "source": "/catalogue/:path*",
      "destination": "/api/handler?__vercel_original_api_path=/catalogue/:path*"
    },
    {
      "source": "/blog/:path*",
      "destination": "/api/handler?__vercel_original_api_path=/blog/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/work",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/get-started",
      "destination": "/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/index.html"
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/index.html"
    },
    {
      "source": "/thank-you",
      "destination": "/index.html"
    }
  ]
}
