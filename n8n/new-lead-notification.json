{
  "name": "NearGrow Ads - New Lead Notification Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "neargrow-lead-webhook",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.email }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Validate Lead Data",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "send",
        "to": "={{ $env.CONTACT_NOTIFICATION_EMAIL || 'leads@neargrowads.com' }}",
        "subject": "=New Lead: {{ $json.body.businessName }} ({{ $json.body.serviceInterest }})",
        "text": "=A new inquiry has been submitted via NearGrow Ads website:\n\nName: {{ $json.body.name }}\nBusiness: {{ $json.body.businessName }}\nEmail: {{ $json.body.email }}\nPhone: {{ $json.body.phone || 'N/A' }}\nService: {{ $json.body.serviceInterest }}\nBudget: {{ $json.body.budgetRange || 'Unspecified' }}\nPreferred Channel: {{ $json.body.preferredContactMethod || 'WhatsApp' }}\nMessage:\n{{ $json.body.message }}\n\nSource: {{ $json.body.sourcePage }}\nUTM Source: {{ $json.body.utmSource || 'direct' }}\nReceived At: {{ $json.body.createdAt }}"
      },
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 200]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "sheetId": "={{ $env.GOOGLE_SHEETS_LEAD_ID }}",
        "range": "Leads!A:K",
        "options": {}
      },
      "name": "Append to Internal Lead Tracker",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [700, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate Lead Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Lead Data": {
      "main": [
        [
          {
            "node": "Send Email Notification",
            "type": "main",
            "index": 0
          },
          {
            "node": "Append to Internal Lead Tracker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
