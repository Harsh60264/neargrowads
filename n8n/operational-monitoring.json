{
  "name": "NearGrow Ads - Operational Monitoring & Health Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "name": "Schedule Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SITE_URL || 'https://neargrowads.com' }}/api/health",
        "options": {
          "timeout": 5000
        }
      },
      "name": "Ping Health Endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    }
  ],
  "connections": {
    "Schedule Check": {
      "main": [
        [
          {
            "node": "Ping Health Endpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
